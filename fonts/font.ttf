import os
from fpdf import FPDF

def make_pdf(lines):
    pdf = FPDF()
    pdf.add_page()
    
    # 1. Point directly to "font.ttf" using an absolute path
    font_path = os.path.join(os.path.dirname(__file__), "font.ttf")
    
    if not os.path.exists(font_path):
        raise FileNotFoundError(f"Could not find font.ttf at: {font_path}")
        
    # 2. Register the font
    pdf.add_font("CustomUnicodeFont", "", font_path)
    
    # 3. Set it as the active font before writing any text
    pdf.set_font("CustomUnicodeFont", size=12)

    for line in lines:
        pdf.multi_cell(0, 6, line, new_x="LMARGIN", new_y="NEXT")
        
    return pdf.output()